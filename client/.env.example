# ========== CampusSphere Client – Environment Variables ==========
# Copy this file to client/.env and fill in your real values.

# In production on Render, the frontend is served by the same Express server,
# so VITE_API_URL is NOT needed (it defaults to /api via relative URL).
# Only set this if running frontend on a DIFFERENT port during local dev:
VITE_API_URL=http://localhost:5000/api
