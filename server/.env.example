# ========== CampusSphere Server – Environment Variables ==========
# Copy this file to server/.env and fill in your real values.
# NEVER commit server/.env to Git.

PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string (get from https://cloud.mongodb.com)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/campussphere?retryWrites=true&w=majority

# JWT Secret — use a long random string in production
JWT_SECRET=replace_with_a_long_random_secret_key_min_32_chars

# Frontend URL (used for CORS in production)
CLIENT_URL=https://your-app-name.onrender.com
